%% Diagrama Mermaid - Arquitetura da aplicação Impulsiona V2
%% Salve como docs/diagram.mmd e visualize com extensão Mermaid ou em https://mermaid.live

flowchart LR
  subgraph VIEW [View (public/)]
    A[index.html]
    B[js/main.js]
    C[js/dados.js]
    D[js/funcionalidades.js]
  end

  subgraph CONTROLLER [Controller (src/controllers/)]
    E[vagasController.js]
  end

  subgraph MODEL [Model (src/models/)]
    F[vagasModel.js]
  end

  subgraph DATABASE [Banco (src/database/)]
    G[database.js]
    H[migration.js]
    I[seeders.js]
    J[db.sqlite]
  end

  %% Fluxo principal
  A -->|fetch /api/vagas| E
  B -->|fetch /api/vagas| E
  C -->|fetch /api/vagas| E
  E -->|chama métodos| F
  F -->|executa SQL via| G
  G --> J

  classDef layer fill:#f8f9fa,stroke:#333,stroke-width:1px;
  class VIEW,CONTROLLER,MODEL,DATABASE layer;

%% ERD simples para a tabela `vagas`

%% Nota: segunda seção é um diagrama separado (use preview que suporta múltiplos blocos)

erDiagram
    VAGAS {
        INTEGER id PK "Primary Key"
        TEXT title "Título"
        TEXT company "Empresa"
        TEXT location "Localização"
        TEXT time "Tempo publicação"
        TEXT type "Tipo (Estágio/CLT)"
        TEXT salary "Salário/Bolsa"
        TEXT target "Curso alvo"
        TEXT desc "Descrição"
        TEXT requirements "JSON array"
        TEXT benefits "JSON array"
    }

%% Fim do arquivo
